# Gmail SMTP (use an App Password — not your normal Gmail login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-or-workspace-address@gmail.com
SMTP_PASS=your-16-char-app-password

# Where leads are delivered
LEAD_TO_EMAIL=info@c4plusdrainage.co.uk

# Optional: From address (defaults to SMTP_USER)
# LEAD_FROM_EMAIL=info@c4plusdrainage.co.uk
